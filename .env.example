# YT-FOMO example environment

# Port on the host for the UI/API
HOST_PORT=8090

# Probe interval (seconds) when not live
INTERVAL_SECONDS=60

# Container timezone
TZ=UTC

# Optional: Gotify notifications (leave empty to disable)
GOTIFY_URL=
GOTIFY_TOKEN=

# Optional retention (0 disables each rule)
# Delete recordings older than N days
RETAIN_MAX_DAYS=0
# Cap per-channel total size (GB); deletes oldest first when over cap
RETAIN_MAX_SIZE_GB=0
# Remove stale partial files older than N hours
CLEAN_PART_AGE_HOURS=0